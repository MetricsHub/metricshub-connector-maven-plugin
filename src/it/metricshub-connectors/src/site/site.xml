<?xml version="1.0" encoding="UTF-8"?>
<site
	xmlns="http://maven.apache.org/SITE/2.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd"
	name="MetricsHub">

	<skin>
		<groupId>org.sentrysoftware.maven</groupId>
		<artifactId>sentry-maven-skin</artifactId>
		<version>8.0.00</version>
	</skin>

	<custom>
		<noDefaultLinks>true</noDefaultLinks>
		<keywords>metricshub, connector, hardware, system, database</keywords>
		<bodyClass>custom-class</bodyClass>
	</custom>

	<bannerLeft name="MetricsHub" href="https://metricshub.com">
		<image src="images/metricshub-logo-only.png" alt="MetricsHub" />
	</bannerLeft>

	<body>

		<links>
			<item name="Fork on GitHub" href="${project.scm.url}" />
		</links>

		<menu name="User Documentation">
			<item name="Getting Started" href="index.html" />
			<item name="Supported Platforms" href="supported-platforms.html"/>
			<item name="Connectors Directory" href="connectors-directory.html"/>
		</menu>

	</body>

</site>
